{
  "version": 3,
  "characterId": "boxgirl",
  "outfitId": "summer",
  "renderer": "point-rig-webgl-v1",
  "canvas": { "width": 1024, "height": 1536, "aspectRatio": "2:3" },
  "background": { "type": "authored", "baseColor": "#1b171d" },
  "runtimeFormat": "webp",
  "pointRigDirectory": "webp-rig",
  "pointRig": {
    "mesh": { "columns": 24, "rows": 36, "boundaryPin": 0.075 },
    "controlPoints": ["head", "neck", "hairLeft", "hairRight", "shoulderLeft", "shoulderRight", "chest", "chestLeft", "chestRight", "waist", "elbowLeft", "elbowRight", "handLeft", "handRight", "cordLeft", "cordRight"],
    "springFrequencyHz": { "range": [2.65, 6.1], "profile": "per-control-point-critical-damping" },
    "maximumTranslation": 0.018,
    "maximumRotationRadians": 0.04,
    "fallback": "transparent-coherent-frame"
  },
  "masterFormat": "png",
  "masterDirectory": "../../../art/boxgirl-v3-summer/masters",
  "transitionMs": 640,
  "frames": {
    "neutral": { "file": "webp/neutral.webp", "role": "idle" },
    "blink": { "file": "webp/blink.webp", "role": "idle-keyframe" },
    "joy": { "file": "webp/joy.webp", "role": "emotion" },
    "joy-blink": { "file": "webp/joy-blink.webp", "role": "emotion-keyframe" },
    "listening": { "file": "webp/listening.webp", "role": "state" },
    "listening-blink": { "file": "webp/listening-blink.webp", "role": "state-keyframe" },
    "thinking": { "file": "webp/thinking.webp", "role": "state" },
    "thinking-blink": { "file": "webp/thinking-blink.webp", "role": "state-keyframe" },
    "private-playful": { "file": "webp/private-playful.webp", "role": "private-easter-egg" },
    "nod-down": { "file": "webp/nod-down.webp", "role": "motion-keyframe" },
    "shake-left": { "file": "webp/shake-left.webp", "role": "motion-keyframe" },
    "shake-right": { "file": "webp/shake-right.webp", "role": "motion-keyframe" },
    "wave": { "file": "webp/wave.webp", "role": "gesture" },
    "explain-left": { "file": "webp/explain-left.webp", "role": "gesture" },
    "explain-right": { "file": "webp/explain-right.webp", "role": "gesture" },
    "celebrate": { "file": "webp/celebrate.webp", "role": "gesture" },
    "concern": { "file": "webp/concern.webp", "role": "emotion" },
    "concern-blink": { "file": "webp/concern-blink.webp", "role": "emotion-keyframe" },
    "confused": { "file": "webp/confused.webp", "role": "emotion-and-shrug" },
    "confused-blink": { "file": "webp/confused-blink.webp", "role": "emotion-keyframe" },
    "surprise": { "file": "webp/surprise.webp", "role": "emotion" },
    "surprise-blink": { "file": "webp/surprise-blink.webp", "role": "emotion-keyframe" },
    "sadness": { "file": "webp/sadness.webp", "role": "emotion" },
    "sadness-blink": { "file": "webp/sadness-blink.webp", "role": "emotion-keyframe" }
  },
  "selectionPriority": ["error", "listening", "thinking", "gesture", "emotion", "neutral"],
  "qualityGates": {
    "dimensionsMatch": true,
    "noAlphaExtraction": true,
    "noClipMaskBodyParts": true,
    "runtimePsnrMinimumDb": 42,
    "preloadAllFrames": true
  }
}
